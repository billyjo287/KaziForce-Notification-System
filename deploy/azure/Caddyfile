# HTTPS in front of the API (ADR 0011). Caddy gets and renews the certificate on its own.
# API_DOMAIN and ACME_EMAIL come from deploy/azure/.env (see docker-compose.yml).
{
	email {$ACME_EMAIL}
	# Keep the visitor's own address that Vercel sends (X-Forwarded-For) instead of replacing it
	# with Vercel's (BT-07): without this every request through the website looked like it came
	# from a different Vercel machine, so log-in limits barely worked and strangers could share
	# one. Vercel's addresses change, so they cannot be listed. Someone calling the API directly
	# can now fake their address for the per-address limits; the per-ACCOUNT log-in limit
	# (rateLimits.ts) cannot be faked and is the real protection.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	# Everything (REST, Socket.IO live alerts, provider webhooks, /o/ tracked links) goes to the API.
	reverse_proxy api:4000
}
