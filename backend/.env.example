# Backend settings. Copy to .env (`npm run setup` does this for you).
# Defaults work for local development with Docker Compose and need NO API keys.

# ---------- Server ----------
# development | test | production
NODE_ENV=development
# Port the API listens on: http://localhost:4000
PORT=4000
# How much to log: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# The website address allowed to call this API (CORS). Must match where the frontend runs.
FRONTEND_ORIGIN=http://localhost:5173
# Public address of the website, used to build links in emails, SMS and WhatsApp messages.
PUBLIC_APP_URL=http://localhost:5173
# Timezone for quiet hours and the 08:00 daily summary.
APP_TIMEZONE=Africa/Nairobi

# ---------- Database and queue ----------
# Postgres connection. User/password/port must match the root .env (Docker Compose).
DATABASE_URL=postgresql://kaziforce:kaziforce@localhost:5434/kaziforce
# Redis connection (stores the BullMQ job queues).
REDIS_URL=redis://localhost:6379
# Name prefix for the job queues and the live-update channel in Redis. The automated tests use
# their own prefix, so they never pick up (or steal) your development jobs.
QUEUE_PREFIX=kf

# ---------- ML service ----------
# Where the FastAPI ML service runs.
ML_SERVICE_URL=http://localhost:8000
# If /predict takes longer than this (milliseconds), use the built-in rules instead.
ML_TIMEOUT_MS=500

# ---------- Channels ----------
# mock    = log messages to the console and database only (no real sends, no keys needed)
# sandbox = use provider test/sandbox accounts
# live    = real WhatsApp/SMS/email (costs money; production only)
CHANNEL_MODE=mock

# Email. In development this points at Mailpit, the fake inbox (read mail at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
# The "From" address on every email we send.
EMAIL_FROM="KaziForce <alerts@kaziforce.local>"

# ---------- Accounts and login ----------
# Secret used to sign login tokens (JWT). In production use a long random string, e.g. the output
# of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-characters
# How long a login token lasts before it is quietly renewed (minutes).
ACCESS_TOKEN_MINUTES=15
# How long someone stays logged in on a device without using it (days). Generous on purpose.
REFRESH_TOKEN_DAYS=30
# Log-in / sign-up attempts allowed per 15 minutes from one network address (slows password
# guessing). Only the automated browser tests raise this.
LOGIN_RATE_LIMIT=10
# How long an employer can press Undo after Accept/Reject before the change is final (seconds).
STATUS_UNDO_SECONDS=15

# The admin account created by the seed script (admins can never sign up themselves).
# Change the password before any real use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Password123!
ADMIN_NAME=KaziForce Admin

# Separate database for automated tests, so they never touch your development data.
# It is created and emptied automatically by the tests.
TEST_DATABASE_URL=postgresql://kaziforce:kaziforce@localhost:5434/kaziforce_test

# ---------- Used from later phases (leave empty for now) ----------
# Phase 5: Twilio (WhatsApp). Only needed when CHANNEL_MODE is sandbox or live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Phase 5: Africa's Talking (SMS). Username "sandbox" for testing.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Phase 5: Resend (email in sandbox/live mode).
RESEND_API_KEY=
