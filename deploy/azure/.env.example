# Settings for the Azure server (ADR 0011, docs/DEPLOYMENT.md).
# On the server: cp .env.example .env && nano .env   — then fill in every "CHANGE-ME".
# The real .env lives only on the server: never commit it, never paste it in a chat.
# Every backend variable is also explained in backend/.env.example.

# ---------- Web addresses ----------
# The server's address, from Azure (Public IP > Configuration > DNS name label), for example
# kaziforce-api.germanywestcentral.cloudapp.azure.com — no https://, no slash at the end.
API_DOMAIN=CHANGE-ME.germanywestcentral.cloudapp.azure.com
# Let's Encrypt writes here only if the HTTPS certificate has a problem.
ACME_EMAIL=CHANGE-ME@example.com
# The same address with https:// (short links in SMS/WhatsApp/email, provider webhooks).
PUBLIC_API_URL=https://CHANGE-ME.germanywestcentral.cloudapp.azure.com
# The website on Vercel, e.g. https://kaziforce.vercel.app (no slash at the end).
FRONTEND_ORIGIN=https://CHANGE-ME.vercel.app
PUBLIC_APP_URL=https://CHANGE-ME.vercel.app

# ---------- Basics ----------
NODE_ENV=production
LOG_LEVEL=info
APP_TIMEZONE=Africa/Nairobi
# Proxies between a visitor and the API: Vercel (which forwards /api) and Caddy = 2.
TRUST_PROXY_HOPS=2
# Prefix for the job queues in Redis.
QUEUE_PREFIX=kf
# How long the worker waits for the ML service before using its own rules (milliseconds).
ML_TIMEOUT_MS=500

# ---------- Database (Supabase) ----------
# Supabase > Connect > Session pooler (port 5432, NOT the transaction pooler on 6543).
# Put your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.CHANGE-ME:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------- Security ----------
# A new random secret (production refuses the example one). Make one with:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE-ME

# The first admin account, created on the first start. Remove ADMIN_PASSWORD from this file
# once you can log in as the admin (it is only used when the admin does not exist yet).
ADMIN_EMAIL=CHANGE-ME@example.com
ADMIN_NAME=KaziForce Admin
ADMIN_PASSWORD=CHANGE-ME-12-or-more-characters

# ---------- Messages ----------
# sandbox = Twilio / Africa's Talking / Resend test accounts (docs/sandbox-test.md);
# live = real messages (costs money); mock = log only (the server has no fake inbox, so emails
# such as password resets are not delivered in mock mode).
CHANNEL_MODE=sandbox
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Resend test sender until you verify your own domain in Resend.
EMAIL_FROM="KaziForce <onboarding@resend.dev>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_ALERT_EN=
TWILIO_TEMPLATE_ALERT_SW=

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Empty in the sandbox (a paid, approved sender name in live mode).
AFRICASTALKING_SENDER_ID=
# Any long random text you make up (same command as JWT_ACCESS_SECRET).
AFRICASTALKING_WEBHOOK_SECRET=CHANGE-ME

# Log-in codes on new devices and sign-up codes (see backend/.env.example). The email code goes
# through Resend: without your own domain, Resend only delivers to YOUR address, so other people
# could not log in on a new device or sign up. Verify a domain first, or set false until then.
ACCOUNT_CODES=true
# Presentation demo codes shown on screen (see backend/.env.example). Must stay false here:
# the server refuses to start in production with true.
OTP_DEMO_MODE=false
