# Root .env — read by docker-compose.yml only.
# Copy to .env (`npm run setup` does this for you). Defaults are for local development only.

# Postgres login created inside the Docker container. Must match DATABASE_URL in backend/.env.
POSTGRES_USER=kaziforce
POSTGRES_PASSWORD=kaziforce
POSTGRES_DB=kaziforce

# Port on YOUR computer that reaches Postgres. 5434 (not the usual 5432) avoids clashing with a
# Postgres you may already have installed, or with other local projects.
POSTGRES_PORT=5434

# Port on your computer that reaches Redis (the job queue store).
REDIS_PORT=6379

# Mailpit, the fake email inbox: the web page to read emails, and the port the app sends mail to.
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Port on your computer that reaches the ML service (FastAPI).
ML_SERVICE_PORT=8000
