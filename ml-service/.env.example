# ML service settings. Copy to .env (`npm run setup` does this for you).

# Which classifier answers /predict:
#   rules    the rule-based classifier (model version "rules-v1"; "rules-v0" was the Sprint II baseline); used until Phase 9
#   trained  a trained model from MODEL_PATH (Phase 9; nothing is trained yet)
CLASSIFIER=rules

# Folder with the trained model files (only used when CLASSIFIER=trained). Leave empty for now.
MODEL_PATH=

# How much the service logs: debug, info, warning or error.
LOG_LEVEL=info
