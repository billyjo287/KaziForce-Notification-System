{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": ["backend/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node dist/worker.js",
    "restartPolicyType": "ALWAYS"
  }
}
