# HTTPS in front of the API (ADR 0011). Caddy gets and renews the certificate on its own.
# API_DOMAIN and ACME_EMAIL come from deploy/azure/.env (see docker-compose.yml).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	# Everything (REST, Socket.IO live alerts, provider webhooks, /o/ tracked links) goes to the API.
	reverse_proxy api:4000
}
