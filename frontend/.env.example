# Frontend settings. Copy to .env (`npm run setup` does this for you).
# Only variables starting with VITE_ reach the browser, so never put secrets here.

# Address of the backend API.
VITE_API_URL=http://localhost:4000

# "true" in production on Vercel: REST calls go to /api on the website's own address, and
# Vercel forwards them to the backend (frontend/vercel.json). Keeps the login cookie working
# in browsers that block other sites' cookies. Leave empty for development.
VITE_SAME_ORIGIN_API=
