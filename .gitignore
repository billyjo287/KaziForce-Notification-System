# ---- Secrets: never commit real .env files (the .env.example files ARE committed) ----
.env
.env.*
!.env.example
# Server keys (the Azure SSH key, certificates): never inside the repository
*.pem
*.key

# KaziForce's own specification documents (not ours to publish) and the thesis drafts (Word,
# PDF, large): kept on this computer only. The repository is public.
docs/requirements/
docs/Write-up/

# ---- Node ----
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.vite/
.eslintcache

# Prisma generated client (rebuilt by `prisma generate`)
backend/src/generated/

# Playwright
test-results/
playwright-report/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ML data and models: datasets and trained models stay out of Git (READMEs are kept)
ml-service/data/*
!ml-service/data/README.md
ml-service/models/*
!ml-service/models/README.md

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Billy's private notes (presentation scripts etc.): never committed
private/

