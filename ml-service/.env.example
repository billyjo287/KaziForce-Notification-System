# ML service settings. Copy to .env (`npm run setup` does this for you).

# Name of the model currently answering /predict. "rules-v0" is the rule-based classifier;
# trained models get names like "ml-v1" later. Stored on every notification for traceability.
MODEL_VERSION=rules-v0

# How much the service logs: debug, info, warning or error.
LOG_LEVEL=info
