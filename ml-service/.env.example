# ML service settings. Copy to .env (`npm run setup` does this for you).

# Which classifier answers /predict:
#   rules    the rule-based classifier (model version "rules-v1"; "rules-v0" was the Sprint II baseline); used until Phase 9
#   trained  the trained model ml-v1 (Phase 9, docs/ml-training.md). Make it first with
#            `python -m training.train` (Docker builds it by itself); the server uses this.
CLASSIFIER=rules

# Folder or file of the trained model (only used when CLASSIFIER=trained). Empty = models/ml-v1.joblib.
MODEL_PATH=

# How much the service logs: debug, info, warning or error.
LOG_LEVEL=info
